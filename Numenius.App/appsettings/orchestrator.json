{
  "Sources": [
    {
      "Type": "Toast",
      "Enabled": true,
      "ConfigFile": "appsettings/toast_source.json"
    },
    {
      "Type": "Manual",
      "Enabled": true,
      "ConfigFile": "appsettings/manual_input.json"
    }
  ],
  "Outputs": [
    {
      "Type": "Console",
      "Enabled": true,
      "ConfigFile": "appsettings/console_output.json"
    },
    {
      "Type": "Tts",
      "Enabled": true,
      "ConfigFile": "appsettings/tts_output.json"
    },
    {
      "Type": "Mqtt",
      "Enabled": false,
      "ConfigFile": "appsettings/mqtt_output.json"
    }
  ],
  "QueueMaxSize": 500,
  "ShutdownTimeoutSeconds": 10
}